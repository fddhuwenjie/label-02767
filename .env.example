# 数据库配置
DB_ROOT_PASSWORD=your_secure_root_password
DB_NAME=rocket_db
DB_USER=rocket
DB_PASSWORD=your_secure_db_password

# 应用密钥 - 生产环境必须更改
# 可使用 openssl rand -base64 32 生成
SECRET_KEY=your_secure_secret_key
ROCKET_SECRET_KEY=your_secure_rocket_secret_key

# 管理员账号 - 首次部署后建议通过后台修改密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password

# 后台管理路径 - 可自定义为复杂路径防扫描
# 例如: admin_panel_k9x2m3 或 system_manage_v5r8
ADMIN_PATH=xuadmin

# 运行环境: development / production
ROCKET_ENV=development

# 日志级别: debug / info / warn / error
RUST_LOG=info

# 站点地址 - 用于生成支付回调URL
PAYMENT_BASE_URL=https://yourdomain.com

# 支付回调签名密钥 - 生产环境必须更改
# 可使用 openssl rand -hex 32 生成
PAYMENT_SECRET=your_secure_payment_secret_key

# 支付宝配置 - 电脑网站支付
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://yourdomain.com/api/payment/callback/alipay
ALIPAY_RETURN_URL=https://yourdomain.com/api/payment/return

# 微信支付配置 - Native扫码支付
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_KEY=
WECHAT_NOTIFY_URL=https://yourdomain.com/api/payment/callback/wechat
