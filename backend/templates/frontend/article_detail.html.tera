{% extends "frontend/base" %}

{% block title %}{{ article.title }} - 资源库{% endblock %}

{% block head %}
<style>
    .prose { max-width: none; }
    .prose h1, .prose h2, .prose h3 { font-weight: 700; color: #1e293b; margin-top: 2em; margin-bottom: 1em; }
    .prose h1 { font-size: 2em; }
    .prose h2 { font-size: 1.5em; }
    .prose h3 { font-size: 1.25em; }
    .prose p { margin-bottom: 1.25em; line-height: 1.8; color: #475569; }
    .prose ul, .prose ol { margin-bottom: 1.25em; padding-left: 1.5em; }
    .prose li { margin-bottom: 0.5em; color: #475569; }
    .prose code { background: #f1f5f9; padding: 0.2em 0.4em; border-radius: 4px; font-size: 0.9em; }
    .prose pre { background: #1e293b; color: #e2e8f0; padding: 1.5em; border-radius: 12px; overflow-x: auto; margin-bottom: 1.5em; }
    .prose pre code { background: none; padding: 0; }
    .prose blockquote { border-left: 4px solid #8b5cf6; padding-left: 1em; margin: 1.5em 0; color: #64748b; font-style: italic; }
    .prose a { color: #8b5cf6; text-decoration: underline; }
    .prose img { border-radius: 12px; margin: 1.5em 0; }
</style>
{% endblock %}

{% block content %}
<div class="w-full px-6 lg:px-12 py-12">
    <!-- 返回链接 -->
    <a href="/articles" class="inline-flex items-center gap-2 text-sm text-slate-500 hover:text-slate-700 mb-8 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        返回列表
    </a>

    <article class="bg-white rounded-3xl border border-slate-200/60 overflow-hidden">
        <!-- 文章头部 -->
        <div class="bg-gradient-to-br from-violet-500 to-purple-600 p-8 lg:p-12">
            <div class="flex flex-wrap items-center gap-3 mb-4">
                {% if category_name %}
                <span class="px-3 py-1 bg-white/20 text-white text-sm font-medium rounded-full">{{ category_name }}</span>
                {% endif %}
                {% if article.is_featured %}
                <span class="px-3 py-1 bg-gradient-to-r from-amber-400 to-orange-500 text-white text-sm font-medium rounded-full">推荐</span>
                {% endif %}
            </div>
            <h1 class="text-2xl lg:text-3xl font-bold text-white mb-4">{{ article.title }}</h1>
            <div class="flex flex-wrap items-center gap-6 text-violet-100 text-sm">
                <span class="flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                    {{ article.created_at | date(format="%Y-%m-%d") }}
                </span>
                <span class="flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                    </svg>
                    {{ article.view_count }} 次浏览
                </span>
            </div>
        </div>

        <div class="p-8 lg:p-12">
            <!-- 标签 -->
            {% if tags | length > 0 %}
            <div class="flex flex-wrap gap-2 mb-8 pb-8 border-b border-slate-100">
                {% for tag in tags %}
                <span class="px-3 py-1.5 bg-slate-100 text-slate-600 text-sm rounded-full">#{{ tag }}</span>
                {% endfor %}
            </div>
            {% endif %}

            <!-- 内容 -->
            <div class="prose mb-10">
                {{ content_html | safe }}
            </div>

            <!-- 资源下载区域 -->
            <div class="mt-10 p-8 bg-gradient-to-br from-slate-50 to-slate-100 rounded-2xl border-2 border-dashed border-slate-200">
                <div class="flex items-center gap-3 mb-6">
                    <div class="w-10 h-10 bg-gradient-to-br from-violet-500 to-purple-600 rounded-xl flex items-center justify-center">
                        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                        </svg>
                    </div>
                    <h3 class="text-lg font-bold text-slate-900">资源下载</h3>
                </div>
                
                {% if show_resource %}
                    {% if article.disk_link %}
                    <div class="space-y-4">
                        {% if platform_name %}
                        <div class="flex items-center gap-4">
                            <span class="text-sm text-slate-500 w-20">网盘平台</span>
                            <span class="text-sm font-medium text-slate-900 px-3 py-1.5 bg-white rounded-lg">{{ platform_name }}</span>
                        </div>
                        {% endif %}
                        <div class="flex items-start gap-4">
                            <span class="text-sm text-slate-500 w-20 pt-1.5">下载链接</span>
                            <a href="{{ article.disk_link }}" target="_blank" class="flex-1 text-sm text-violet-600 hover:text-violet-700 break-all bg-white px-4 py-3 rounded-lg border border-slate-200 hover:border-violet-300 transition-colors">
                                {{ article.disk_link }}
                            </a>
                        </div>
                        {% if article.disk_password %}
                        <div class="flex items-center gap-4">
                            <span class="text-sm text-slate-500 w-20">提取密码</span>
                            <code class="px-4 py-2 bg-amber-50 text-amber-700 rounded-lg font-mono text-sm border border-amber-200">{{ article.disk_password }}</code>
                        </div>
                        {% endif %}
                        {% if not article.is_link_valid %}
                        <div class="mt-4 p-4 bg-rose-50 text-rose-600 rounded-xl flex items-center gap-3">
                            <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                            </svg>
                            <span class="text-sm">此链接可能已失效，请联系管理员更新</span>
                        </div>
                        {% endif %}
                    </div>
                    {% else %}
                    <p class="text-slate-500 text-center py-4">暂无下载链接</p>
                    {% endif %}
                {% else %}
                    <div class="text-center py-8">
                        <div class="w-16 h-16 bg-slate-200 rounded-full flex items-center justify-center mx-auto mb-4">
                            <svg class="w-8 h-8 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                            </svg>
                        </div>
                        <p class="text-slate-600 mb-6">购买会员后可查看下载链接</p>
                        <a href="/pricing" class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-violet-500 to-purple-600 text-white font-medium rounded-full hover:shadow-lg hover:shadow-violet-500/30 transition-all">
                            立即开通会员
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                            </svg>
                        </a>
                    </div>
                {% endif %}
            </div>
        </div>
    </article>
</div>
{% endblock %}
