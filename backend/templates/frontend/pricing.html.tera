{% extends "frontend/base" %}

{% block title %}会员定价 - 资源库{% endblock %}

{% block content %}
<div class="max-w-6xl mx-auto px-6 lg:px-8 py-16">
    <!-- 页面标题 -->
    <div class="text-center mb-16">
        <h1 class="text-4xl font-bold text-slate-900 mb-4">选择适合您的方案</h1>
        <p class="text-lg text-slate-500 max-w-2xl mx-auto">购买会员后即可查看所有资源的下载链接，享受无限下载特权</p>
        
        <!-- 当前会员状态 -->
        {% if user %}
        <div class="mt-6 inline-flex items-center gap-2 px-4 py-2 bg-slate-100 rounded-full">
            <span class="text-sm text-slate-600">当前状态：</span>
            {% if user.membership_type == "none" %}
            <span class="text-sm font-medium text-slate-900">普通用户</span>
            {% elif user.membership_type == "monthly" %}
            <span class="text-sm font-medium text-blue-600">月度会员</span>
            {% elif user.membership_type == "quarterly" %}
            <span class="text-sm font-medium text-emerald-600">季度会员</span>
            {% elif user.membership_type == "yearly" %}
            <span class="text-sm font-medium text-amber-600">年度会员</span>
            {% elif user.membership_type == "permanent" %}
            <span class="text-sm font-medium text-violet-600">永久会员</span>
            {% endif %}
            {% if user.membership_expires_at and user.membership_type != "permanent" and user.membership_type != "none" %}
            <span class="text-sm text-slate-500">（{{ user.membership_expires_at | date(format="%Y-%m-%d") }} 到期）</span>
            {% endif %}
        </div>
        {% endif %}
    </div>

    <!-- 定价卡片 -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {% for plan in pricing %}
        <div class="relative bg-white rounded-3xl border-2 {% if plan.membership_type == 'yearly' %}border-violet-500 shadow-xl shadow-violet-500/10{% else %}border-slate-200{% endif %} p-8 flex flex-col">
            {% if plan.membership_type == "yearly" %}
            <div class="absolute -top-4 left-1/2 -translate-x-1/2">
                <span class="px-4 py-1.5 bg-gradient-to-r from-violet-500 to-purple-600 text-white text-sm font-semibold rounded-full shadow-lg">最受欢迎</span>
            </div>
            {% endif %}
            
            <div class="mb-6">
                <h3 class="text-lg font-bold text-slate-900 mb-2">
                    {% if plan.membership_type == "monthly" %}月度会员
                    {% elif plan.membership_type == "quarterly" %}季度会员
                    {% elif plan.membership_type == "yearly" %}年度会员
                    {% elif plan.membership_type == "permanent" %}永久会员
                    {% endif %}
                </h3>
                <p class="text-sm text-slate-500">{{ plan.description }}</p>
            </div>
            
            <div class="mb-8">
                <span class="text-4xl font-bold text-slate-900">¥{{ plan.price | round }}</span>
                <span class="text-slate-500">
                    {% if plan.membership_type == "permanent" %}/永久{% else %}/{{ plan.membership_type }}{% endif %}
                </span>
            </div>
            
            <ul class="space-y-4 mb-8 flex-1">
                <li class="flex items-center gap-3 text-sm text-slate-600">
                    <svg class="w-5 h-5 text-emerald-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    查看所有资源链接
                </li>
                <li class="flex items-center gap-3 text-sm text-slate-600">
                    <svg class="w-5 h-5 text-emerald-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    无限次下载
                </li>
                <li class="flex items-center gap-3 text-sm text-slate-600">
                    <svg class="w-5 h-5 text-emerald-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    优先客服支持
                </li>
                {% if plan.membership_type == "permanent" %}
                <li class="flex items-center gap-3 text-sm text-slate-600">
                    <svg class="w-5 h-5 text-emerald-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    终身免费更新
                </li>
                {% endif %}
            </ul>
            
            {% if user %}
                {% if user.membership_type == "permanent" %}
                <button disabled class="w-full py-3.5 bg-slate-100 text-slate-400 font-medium rounded-full cursor-not-allowed">
                    已是永久会员
                </button>
                {% elif user.membership_type == plan.membership_type %}
                <button onclick="createOrder('{{ plan.membership_type }}')" 
                        class="w-full py-3.5 bg-emerald-500 text-white hover:bg-emerald-600 font-medium rounded-full transition-all">
                    续费
                </button>
                {% else %}
                <button onclick="createOrder('{{ plan.membership_type }}')" 
                        class="w-full py-3.5 {% if plan.membership_type == 'yearly' %}bg-gradient-to-r from-violet-500 to-purple-600 text-white hover:shadow-lg hover:shadow-violet-500/30{% else %}bg-slate-900 text-white hover:bg-slate-800{% endif %} font-medium rounded-full transition-all">
                    {% if user.membership_type != "none" %}升级{% else %}立即购买{% endif %}
                </button>
                {% endif %}
            {% else %}
            <a href="/login" class="block w-full py-3.5 text-center {% if plan.membership_type == 'yearly' %}bg-gradient-to-r from-violet-500 to-purple-600 text-white hover:shadow-lg hover:shadow-violet-500/30{% else %}bg-slate-900 text-white hover:bg-slate-800{% endif %} font-medium rounded-full transition-all">
                登录后购买
            </a>
            {% endif %}
        </div>
        {% endfor %}
    </div>

    <!-- 说明 -->
    <div class="mt-12 text-center">
        <p class="text-slate-500 text-sm">支持支付宝、微信支付 · 支付后会员立即生效 · 续费会员时长自动累加 · 如有问题请联系客服</p>
    </div>
</div>

<!-- 支付弹窗 -->
<div id="pay-modal" class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center z-50">
    <div class="bg-white rounded-3xl p-8 max-w-md w-full mx-4 shadow-2xl">
        <h3 class="text-xl font-bold text-slate-900 mb-2 text-center">确认支付</h3>
        <p class="text-sm text-slate-500 text-center mb-6">选择支付方式完成订单</p>
        
        <input type="hidden" id="order-id">
        
        <!-- 订单信息 -->
        <div class="bg-slate-50 rounded-2xl p-4 mb-6">
            <div class="flex justify-between items-center mb-2">
                <span class="text-sm text-slate-500">订单类型</span>
                <span id="order-type" class="font-medium text-slate-900">-</span>
            </div>
            <div class="flex justify-between items-center">
                <span class="text-sm text-slate-500">支付金额</span>
                <span id="order-amount" class="text-xl font-bold text-violet-600">¥0</span>
            </div>
        </div>
        
        <div class="space-y-3">
            <button id="btn-alipay" onclick="payOrder('alipay')" class="w-full py-4 bg-[#1677FF] text-white font-medium rounded-2xl hover:opacity-90 transition-opacity flex items-center justify-center gap-3">
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M21.422 14.262c-1.584-.776-3.298-1.478-5.252-2.14.578-1.288 1.02-2.698 1.296-4.2H13.26v-1.74h5.292V5.1H13.26V2.28c0-.264-.168-.42-.456-.42H10.62V5.1H5.52v1.08h5.1v1.74H6.18v1.08h9.78c-.36 1.2-.828 2.34-1.392 3.36-3.096-.828-6.192-1.356-8.568-1.164-5.004.39-7.476 3.066-7.224 6.138.252 3.072 3.3 5.424 8.352 4.8 3.264-.408 6.168-1.992 8.604-4.188 2.544 1.344 4.668 2.832 6.312 4.128L24 18.768c-1.596-1.128-3.672-2.46-9.324-4.728zM4.2 18.498c-2.532.324-4.296-.672-4.44-1.728-.156-1.26 1.236-2.568 3.6-2.784 1.932-.168 4.284.24 6.708.9-1.728 1.908-3.72 3.276-5.868 3.612z"/>
                </svg>
                支付宝支付
            </button>
            <button id="btn-wechat" onclick="payOrder('wechat')" class="w-full py-4 bg-[#07C160] text-white font-medium rounded-2xl hover:opacity-90 transition-opacity flex items-center justify-center gap-3">
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M8.691 2.188C3.891 2.188 0 5.476 0 9.53c0 2.212 1.17 4.203 3.002 5.55a.59.59 0 01.213.665l-.39 1.48c-.019.07-.048.141-.048.213 0 .163.13.295.29.295a.326.326 0 00.167-.054l1.903-1.114a.864.864 0 01.717-.098 10.16 10.16 0 002.837.403c.276 0 .543-.027.811-.05-.857-2.578.157-4.972 1.932-6.446 1.703-1.415 3.882-1.98 5.853-1.838-.576-3.583-4.196-6.348-8.596-6.348zM5.785 5.991c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 01-1.162 1.178A1.17 1.17 0 014.623 7.17c0-.651.52-1.18 1.162-1.18zm5.813 0c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 01-1.162 1.178 1.17 1.17 0 01-1.162-1.178c0-.651.52-1.18 1.162-1.18zm3.636 4.843c-2.014-.083-3.96.59-5.27 1.774-1.258 1.135-1.98 2.729-1.98 4.37 0 3.467 3.212 6.276 7.168 6.276.84 0 1.66-.125 2.428-.345a.744.744 0 01.615.084l1.63.956a.28.28 0 00.143.046c.138 0 .25-.113.25-.253 0-.062-.025-.122-.04-.182l-.335-1.268a.506.506 0 01.183-.571c1.57-1.155 2.573-2.867 2.573-4.743 0-3.28-3.12-6.017-7.162-6.144h-.203zm-1.834 3.097c.552 0 .998.454.998 1.014a1.007 1.007 0 01-.998 1.013.998.998 0 110-1.997v-.03zm4.49 0c.551 0 .998.454.998 1.014a1.007 1.007 0 01-.998 1.013 1.007 1.007 0 01-.998-1.013c0-.56.447-1.014.998-1.014z"/>
                </svg>
                微信支付
            </button>
        </div>
        <button onclick="closePayModal()" class="w-full mt-4 py-3 text-slate-500 hover:text-slate-700 font-medium transition-colors">取消</button>
    </div>
</div>

<!-- 支付处理中弹窗 -->
<div id="processing-modal" class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center z-50">
    <div class="bg-white rounded-3xl p-8 max-w-sm w-full mx-4 shadow-2xl text-center">
        <div class="w-20 h-20 bg-blue-50 rounded-full flex items-center justify-center mx-auto mb-6">
            <svg class="w-10 h-10 text-blue-500 animate-spin" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
        </div>
        <h3 class="text-xl font-bold text-slate-900 mb-2">支付处理中</h3>
        <p id="processing-text" class="text-slate-500 mb-6">正在处理您的支付请求...</p>
        <button onclick="cancelPolling()" class="w-full py-3 text-slate-500 hover:text-slate-700 border border-slate-200 rounded-full font-medium transition-colors">取消</button>
    </div>
</div>

<!-- 支付成功弹窗 -->
<div id="success-modal" class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center z-50">
    <div class="bg-white rounded-3xl p-8 max-w-sm w-full mx-4 shadow-2xl text-center">
        <div class="w-20 h-20 bg-emerald-100 rounded-full flex items-center justify-center mx-auto mb-6">
            <svg class="w-10 h-10 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
        </div>
        <h3 class="text-xl font-bold text-slate-900 mb-2">支付成功！</h3>
        <p class="text-slate-500 mb-6">您的会员已开通，现在可以查看所有资源了</p>
        <button onclick="window.location.href='/profile'" class="w-full py-3.5 bg-gradient-to-r from-violet-500 to-purple-600 text-white font-medium rounded-full hover:shadow-lg transition-all">
            查看我的会员
        </button>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
const membershipNames = {
    'monthly': '月度会员',
    'quarterly': '季度会员',
    'yearly': '年度会员',
    'permanent': '永久会员'
};

let pollingTimer = null;
let currentOrderId = null;

async function createOrder(membershipType) {
    try {
        const res = await fetch('/api/orders', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ membership_type: membershipType })
        });
        const result = await res.json();
        if (result.success) {
            currentOrderId = result.data.id;
            document.getElementById('order-id').value = result.data.id;
            document.getElementById('order-type').textContent = membershipNames[membershipType] || membershipType;
            document.getElementById('order-amount').textContent = '¥' + result.data.amount;
            document.getElementById('pay-modal').classList.remove('hidden');
        } else {
            showError(result.message);
        }
    } catch (err) {
        showError('创建订单失败');
    }
}

async function payOrder(method) {
    const orderId = document.getElementById('order-id').value;
    const btnAlipay = document.getElementById('btn-alipay');
    const btnWechat = document.getElementById('btn-wechat');
    btnAlipay.disabled = true;
    btnWechat.disabled = true;

    try {
        const res = await fetch('/api/orders/pay', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ order_id: orderId, payment_method: method })
        });
        const result = await res.json();

        if (result.success) {
            const data = result.data;

            if (data.payment_url) {
                document.getElementById('pay-modal').classList.add('hidden');
                document.getElementById('processing-modal').classList.remove('hidden');
                document.getElementById('processing-text').textContent = '正在跳转到支付页面...';
                startPolling(orderId);
                window.open(data.payment_url, '_blank');
            } else if (data.qr_code_url) {
                document.getElementById('pay-modal').classList.add('hidden');
                document.getElementById('processing-modal').classList.remove('hidden');
                document.getElementById('processing-text').textContent = '请在新窗口中完成微信支付，支付完成后页面会自动更新';
                startPolling(orderId);
            } else {
                document.getElementById('pay-modal').classList.add('hidden');
                document.getElementById('success-modal').classList.remove('hidden');
            }
        } else {
            showError(result.message);
            btnAlipay.disabled = false;
            btnWechat.disabled = false;
        }
    } catch (err) {
        showError('支付请求失败，请重试');
        btnAlipay.disabled = false;
        btnWechat.disabled = false;
    }
}

function startPolling(orderId) {
    let attempts = 0;
    const maxAttempts = 120;

    pollingTimer = setInterval(async () => {
        attempts++;
        if (attempts > maxAttempts) {
            cancelPolling();
            showError('支付超时，请查看订单状态或重新支付');
            return;
        }

        try {
            const res = await fetch(`/api/orders/${orderId}/status`);
            const result = await res.json();
            if (result.success && result.data.paid) {
                cancelPolling();
                document.getElementById('processing-modal').classList.add('hidden');
                document.getElementById('success-modal').classList.remove('hidden');
            }
        } catch (err) {
            // polling errors are non-fatal
        }
    }, 3000);
}

function cancelPolling() {
    if (pollingTimer) {
        clearInterval(pollingTimer);
        pollingTimer = null;
    }
    document.getElementById('processing-modal').classList.add('hidden');
    const btnAlipay = document.getElementById('btn-alipay');
    const btnWechat = document.getElementById('btn-wechat');
    if (btnAlipay) btnAlipay.disabled = false;
    if (btnWechat) btnWechat.disabled = false;
}

function closePayModal() {
    document.getElementById('pay-modal').classList.add('hidden');
    const btnAlipay = document.getElementById('btn-alipay');
    const btnWechat = document.getElementById('btn-wechat');
    if (btnAlipay) btnAlipay.disabled = false;
    if (btnWechat) btnWechat.disabled = false;
}
</script>
{% endblock %}
