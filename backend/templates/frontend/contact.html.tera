{% extends "frontend/base" %}

{% block title %}联系我们 - 资源库{% endblock %}

{% block content %}
<div class="max-w-4xl mx-auto px-6 lg:px-8 py-16">
    <!-- 页面标题 -->
    <div class="text-center mb-16">
        <div class="w-16 h-16 bg-gradient-to-br from-violet-500 to-purple-600 rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-lg shadow-violet-500/30">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
        </div>
        <h1 class="text-3xl font-bold text-slate-900 mb-4">联系我们</h1>
        <p class="text-lg text-slate-500">有任何问题或建议，欢迎随时联系我们</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
        <!-- 联系方式 -->
        <div class="space-y-6">
            <div class="bg-white rounded-2xl border border-slate-200 p-6">
                <div class="flex items-center gap-4 mb-4">
                    <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center">
                        <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                        </svg>
                    </div>
                    <div>
                        <h3 class="font-bold text-slate-900">电子邮件</h3>
                        <p class="text-slate-500 text-sm">工作日24小时内回复</p>
                    </div>
                </div>
                <a href="mailto:support@example.com" class="text-violet-600 hover:text-violet-700 font-medium">support@example.com</a>
            </div>

            <div class="bg-white rounded-2xl border border-slate-200 p-6">
                <div class="flex items-center gap-4 mb-4">
                    <div class="w-12 h-12 bg-amber-100 rounded-xl flex items-center justify-center">
                        <svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                    </div>
                    <div>
                        <h3 class="font-bold text-slate-900">服务时间</h3>
                        <p class="text-slate-500 text-sm">在线客服工作时间</p>
                    </div>
                </div>
                <div class="space-y-2 text-slate-600">
                    <p>周一至周五：9:00 - 18:00</p>
                    <p>周六至周日：10:00 - 17:00</p>
                    <p class="text-sm text-slate-400">（法定节假日休息）</p>
                </div>
            </div>
        </div>

        <!-- 留言表单 -->
        <div class="bg-white rounded-2xl border border-slate-200 p-8">
            <h2 class="text-xl font-bold text-slate-900 mb-6">在线留言</h2>
            
            <form id="contact-form" class="space-y-5">
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-2">您的称呼</label>
                    <input type="text" name="name" required
                           class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-violet-500/50 focus:border-violet-500 focus:bg-white transition-all"
                           placeholder="请输入您的称呼">
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-2">联系邮箱</label>
                    <input type="email" name="email" required
                           class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-violet-500/50 focus:border-violet-500 focus:bg-white transition-all"
                           placeholder="请输入您的邮箱">
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-2">问题类型</label>
                    <select name="type" required
                            class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-violet-500/50 focus:border-violet-500 focus:bg-white transition-all">
                        <option value="">请选择问题类型</option>
                        <option value="account">账号问题</option>
                        <option value="payment">支付问题</option>
                        <option value="download">下载问题</option>
                        <option value="resource">资源反馈</option>
                        <option value="suggestion">意见建议</option>
                        <option value="other">其他问题</option>
                    </select>
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-2">详细描述</label>
                    <textarea name="message" rows="5" required
                              class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-violet-500/50 focus:border-violet-500 focus:bg-white transition-all resize-none"
                              placeholder="请详细描述您的问题或建议..."></textarea>
                </div>
                
                <button type="submit" class="w-full py-4 bg-gradient-to-r from-violet-500 to-purple-600 text-white font-semibold rounded-xl hover:shadow-lg hover:shadow-violet-500/30 transition-all">
                    提交留言
                </button>
            </form>
            
            <p class="text-sm text-slate-400 text-center mt-4">我们会在1-2个工作日内回复您的留言</p>
        </div>
    </div>

    <!-- 常见问题提示 -->
    <div class="mt-12 bg-slate-50 rounded-2xl p-8 text-center">
        <h3 class="font-bold text-slate-900 mb-2">在联系我们之前</h3>
        <p class="text-slate-500 mb-4">您可以先查看常见问题，也许能快速找到答案</p>
        <div class="flex justify-center gap-4">
            <a href="/help" class="px-6 py-3 bg-white text-slate-700 font-medium rounded-full border border-slate-200 hover:border-violet-300 hover:text-violet-600 transition-all">
                使用指南
            </a>
            <a href="/faq" class="px-6 py-3 bg-white text-slate-700 font-medium rounded-full border border-slate-200 hover:border-violet-300 hover:text-violet-600 transition-all">
                常见问题
            </a>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
document.getElementById('contact-form').addEventListener('submit', function(e) {
    e.preventDefault();
    
    // 模拟提交
    const btn = this.querySelector('button[type="submit"]');
    btn.disabled = true;
    btn.innerHTML = '<svg class="animate-spin h-5 w-5 mx-auto" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>';
    
    setTimeout(() => {
        alert('感谢您的留言！我们会尽快回复您。');
        this.reset();
        btn.disabled = false;
        btn.textContent = '提交留言';
    }, 1500);
});
</script>
{% endblock %}
