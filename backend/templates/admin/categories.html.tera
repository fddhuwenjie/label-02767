{% extends "admin/base" %}

{% block title %}分类管理 - 后台管理{% endblock %}
{% block page_title %}分类管理{% endblock %}

{% block content %}
<!-- 顶部操作栏 -->
<div class="flex items-center justify-between mb-6">
    <p class="text-gray-500">管理文章分类，分类可用于文章归类和筛选</p>
    <button onclick="showAddModal()" class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-violet-500 to-purple-600 text-white font-medium rounded-xl hover:from-violet-600 hover:to-purple-700 transition-all shadow-lg shadow-violet-500/25">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
        </svg>
        添加分类
    </button>
</div>

<!-- 分类列表 -->
<div class="bg-white rounded-2xl border border-gray-100 shadow-lg shadow-gray-100/50 overflow-hidden">
    {% if categories | length > 0 %}
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead class="bg-gray-50">
                <tr>
                    <th class="text-left px-6 py-4 text-xs font-medium text-gray-500 uppercase tracking-wider">分类名称</th>
                    <th class="text-left px-6 py-4 text-xs font-medium text-gray-500 uppercase tracking-wider">排序</th>
                    <th class="text-left px-6 py-4 text-xs font-medium text-gray-500 uppercase tracking-wider">创建时间</th>
                    <th class="text-right px-6 py-4 text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                {% for cat in categories %}
                <tr class="hover:bg-gray-50 transition-colors">
                    <td class="px-6 py-4">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 bg-gradient-to-br from-violet-100 to-purple-100 rounded-xl flex items-center justify-center">
                                <svg class="w-5 h-5 text-violet-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
                                </svg>
                            </div>
                            <span class="font-medium text-gray-900">{{ cat.name }}</span>
                        </div>
                    </td>
                    <td class="px-6 py-4">
                        <span class="px-3 py-1 bg-gray-100 text-gray-600 text-sm font-medium rounded-lg">{{ cat.sort_order }}</span>
                    </td>
                    <td class="px-6 py-4 text-gray-500 text-sm">
                        {{ cat.created_at | date(format="%Y-%m-%d") }}
                    </td>
                    <td class="px-6 py-4">
                        <div class="flex items-center justify-end gap-2">
                            <button onclick="deleteCategory('{{ cat.id }}')" class="p-2 text-gray-500 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors" title="删除">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                </svg>
                            </button>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% else %}
    <div class="py-16 text-center">
        <div class="w-16 h-16 bg-gray-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
            </svg>
        </div>
        <p class="text-gray-500 mb-4">暂无分类</p>
        <button onclick="showAddModal()" class="inline-flex items-center gap-2 px-5 py-2.5 bg-violet-600 text-white font-medium rounded-xl hover:bg-violet-700 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            创建第一个分类
        </button>
    </div>
    {% endif %}
</div>

<!-- 添加弹窗 -->
<div id="add-modal" class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm flex items-center justify-center z-50 p-4">
    <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full">
        <div class="px-6 py-4 border-b border-gray-100">
            <h3 class="text-lg font-semibold text-gray-900">添加分类</h3>
        </div>
        <form id="add-form" class="p-6 space-y-5">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">分类名称</label>
                <input type="text" id="add-name" required placeholder="如：教程资源"
                       class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-violet-500 focus:bg-white">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">排序值</label>
                <input type="number" id="add-sort" value="0" 
                       class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-violet-500 focus:bg-white">
                <p class="mt-2 text-xs text-gray-400">数字越小排序越靠前</p>
            </div>
            <div class="flex gap-3 pt-4">
                <button type="submit" class="flex-1 py-3 bg-gradient-to-r from-violet-500 to-purple-600 text-white font-medium rounded-xl hover:from-violet-600 hover:to-purple-700">创建</button>
                <button type="button" onclick="closeModal()" class="flex-1 py-3 border border-gray-200 text-gray-600 font-medium rounded-xl hover:bg-gray-50">取消</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
function showAddModal() {
    document.getElementById('add-modal').classList.remove('hidden');
}

function closeModal() {
    document.getElementById('add-modal').classList.add('hidden');
}

document.getElementById('add-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = {
        name: document.getElementById('add-name').value,
        sort_order: parseInt(document.getElementById('add-sort').value) || 0
    };

    try {
        const res = await fetch('/xuadmin/categories', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        const result = await res.json();
        if (result.success) window.location.reload();
        else alert(result.message);
    } catch (err) {
        alert('创建失败');
    }
});

async function deleteCategory(id) {
    if (!confirm('确定要删除这个分类吗？删除后相关文章的分类将被清空。')) return;
    try {
        const res = await fetch(`/xuadmin/categories/${id}`, { method: 'DELETE' });
        const result = await res.json();
        if (result.success) window.location.reload();
        else alert(result.message);
    } catch (err) {
        alert('删除失败');
    }
}
</script>
{% endblock %}
