{% extends "admin/base" %}

{% block title %}用户管理 - 后台管理{% endblock %}
{% block page_title %}用户管理{% endblock %}

{% block content %}
<!-- 顶部操作栏 -->
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <div class="flex items-center gap-3">
        <div class="relative">
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            <input type="text" placeholder="搜索用户..." class="pl-10 pr-4 py-2.5 bg-white border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-violet-500 focus:border-transparent w-64">
        </div>
    </div>
    <button onclick="showAddUserModal()" class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-violet-500 to-purple-600 text-white font-medium rounded-xl hover:from-violet-600 hover:to-purple-700 transition-all shadow-lg shadow-violet-500/25">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
        </svg>
        添加用户
    </button>
</div>

<!-- 用户列表 -->
<div class="bg-white rounded-2xl border border-gray-100 shadow-lg shadow-gray-100/50 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead class="bg-gray-50">
                <tr>
                    <th class="text-left px-6 py-4 text-xs font-medium text-gray-500 uppercase tracking-wider">用户信息</th>
                    <th class="text-left px-6 py-4 text-xs font-medium text-gray-500 uppercase tracking-wider">会员状态</th>
                    <th class="text-left px-6 py-4 text-xs font-medium text-gray-500 uppercase tracking-wider">积分</th>
                    <th class="text-left px-6 py-4 text-xs font-medium text-gray-500 uppercase tracking-wider">状态</th>
                    <th class="text-left px-6 py-4 text-xs font-medium text-gray-500 uppercase tracking-wider">注册时间</th>
                    <th class="text-right px-6 py-4 text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                {% for u in users %}
                <tr class="hover:bg-gray-50 transition-colors">
                    <td class="px-6 py-4">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 bg-gradient-to-br from-violet-500 to-purple-600 rounded-xl flex items-center justify-center text-white">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                </svg>
                            </div>
                            <div>
                                <div class="flex items-center gap-2">
                                    <span class="font-medium text-gray-900">{{ u.username }}</span>
                                    {% if u.is_admin %}
                                    <span class="px-2 py-0.5 bg-violet-100 text-violet-700 text-xs font-medium rounded-full">管理员</span>
                                    {% endif %}
                                </div>
                                <p class="text-sm text-gray-500">{{ u.email }}</p>
                            </div>
                        </div>
                    </td>
                    <td class="px-6 py-4">
                        {% if u.membership_type == "none" %}
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-gray-100 text-gray-600 text-sm font-medium rounded-full">
                            普通用户
                        </span>
                        {% elif u.membership_type == "monthly" %}
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-blue-100 text-blue-700 text-sm font-medium rounded-full">
                            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                            </svg>
                            月度会员
                        </span>
                        {% elif u.membership_type == "quarterly" %}
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-emerald-100 text-emerald-700 text-sm font-medium rounded-full">
                            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                            </svg>
                            季度会员
                        </span>
                        {% elif u.membership_type == "yearly" %}
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-amber-100 text-amber-700 text-sm font-medium rounded-full">
                            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                            </svg>
                            年度会员
                        </span>
                        {% elif u.membership_type == "permanent" %}
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-gradient-to-r from-violet-500 to-purple-600 text-white text-sm font-medium rounded-full shadow-sm">
                            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M5 2a1 1 0 011 1v1h1a1 1 0 010 2H6v1a1 1 0 01-2 0V6H3a1 1 0 010-2h1V3a1 1 0 011-1zm0 10a1 1 0 011 1v1h1a1 1 0 110 2H6v1a1 1 0 11-2 0v-1H3a1 1 0 110-2h1v-1a1 1 0 011-1zM12 2a1 1 0 01.967.744L14.146 7.2 17.5 9.134a1 1 0 010 1.732l-3.354 1.935-1.18 4.455a1 1 0 01-1.933 0L9.854 12.8 6.5 10.866a1 1 0 010-1.732l3.354-1.935 1.18-4.455A1 1 0 0112 2z" clip-rule="evenodd"/>
                            </svg>
                            永久会员
                        </span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4">
                        <span class="font-semibold text-violet-600">{{ u.points }}</span>
                    </td>
                    <td class="px-6 py-4">
                        {% if u.is_frozen %}
                        <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-red-100 text-red-700 text-xs font-medium rounded-full">
                            <span class="w-1.5 h-1.5 bg-red-500 rounded-full"></span>
                            已冻结
                        </span>
                        {% else %}
                        <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-green-100 text-green-700 text-xs font-medium rounded-full">
                            <span class="w-1.5 h-1.5 bg-green-500 rounded-full"></span>
                            正常
                        </span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4 text-gray-500 text-sm">
                        {{ u.created_at | date(format="%Y-%m-%d") }}
                    </td>
                    <td class="px-6 py-4">
                        <div class="flex items-center justify-end gap-2">
                            <button onclick="editUser('{{ u.id }}', '{{ u.membership_type }}', {{ u.points }}, {{ u.is_frozen }}, {{ u.is_admin }})" class="p-2 text-gray-500 hover:text-violet-600 hover:bg-violet-50 rounded-lg transition-colors" title="编辑">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                </svg>
                            </button>
                            {% if not u.is_admin %}
                            <button onclick="deleteUser('{{ u.id }}')" class="p-2 text-gray-500 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors" title="删除">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                </svg>
                            </button>
                            {% endif %}
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% if total_pages > 1 %}
    <div class="px-6 py-4 border-t border-gray-100 flex items-center justify-between">
        <p class="text-sm text-gray-500">共 {{ total_pages }} 页</p>
        <div class="flex items-center gap-2">
            {% if current_page > 1 %}
            <a href="/xuadmin/users?page={{ current_page - 1 }}" class="px-4 py-2 text-sm font-medium text-gray-600 bg-white border border-gray-200 rounded-lg hover:bg-gray-50">上一页</a>
            {% endif %}
            <span class="px-4 py-2 text-sm font-medium text-white bg-violet-600 rounded-lg">{{ current_page }}</span>
            {% if current_page < total_pages %}
            <a href="/xuadmin/users?page={{ current_page + 1 }}" class="px-4 py-2 text-sm font-medium text-gray-600 bg-white border border-gray-200 rounded-lg hover:bg-gray-50">下一页</a>
            {% endif %}
        </div>
    </div>
    {% endif %}
</div>

<!-- 编辑用户弹窗 -->
<div id="edit-modal" class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm flex items-center justify-center z-50 p-4">
    <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full">
        <div class="px-6 py-4 border-b border-gray-100">
            <h3 class="text-lg font-semibold text-gray-900">编辑用户</h3>
        </div>
        <form id="edit-form" class="p-6 space-y-5">
            <input type="hidden" id="edit-user-id">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">会员类型</label>
                <select id="edit-membership" class="custom-select w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-violet-500">
                    <option value="none">普通用户</option>
                    <option value="monthly">月度会员</option>
                    <option value="quarterly">季度会员</option>
                    <option value="yearly">年度会员</option>
                    <option value="permanent">永久会员</option>
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">积分</label>
                <input type="number" id="edit-points" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-violet-500">
            </div>
            <div class="flex items-center gap-6">
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" id="edit-frozen" class="w-4 h-4 text-violet-600 rounded focus:ring-violet-500">
                    <span class="text-sm text-gray-700">冻结账号</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" id="edit-admin" class="w-4 h-4 text-violet-600 rounded focus:ring-violet-500">
                    <span class="text-sm text-gray-700">管理员</span>
                </label>
            </div>
            <div class="flex gap-3 pt-4">
                <button type="submit" class="flex-1 py-3 bg-gradient-to-r from-violet-500 to-purple-600 text-white font-medium rounded-xl hover:from-violet-600 hover:to-purple-700">保存</button>
                <button type="button" onclick="closeEditModal()" class="flex-1 py-3 border border-gray-200 text-gray-600 font-medium rounded-xl hover:bg-gray-50">取消</button>
            </div>
        </form>
    </div>
</div>

<!-- 添加用户弹窗 -->
<div id="add-modal" class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm flex items-center justify-center z-50 p-4">
    <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full max-h-[90vh] overflow-y-auto">
        <div class="px-6 py-4 border-b border-gray-100 sticky top-0 bg-white">
            <h3 class="text-lg font-semibold text-gray-900">添加用户</h3>
        </div>
        <form id="add-form" class="p-6 space-y-5">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">用户名</label>
                <input type="text" id="add-username" required class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-violet-500">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">邮箱</label>
                <input type="email" id="add-email" required class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-violet-500">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">密码</label>
                <input type="password" id="add-password" required class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-violet-500">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">会员类型</label>
                <select id="add-membership" class="custom-select w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-violet-500">
                    <option value="none">普通用户</option>
                    <option value="monthly">月度会员</option>
                    <option value="quarterly">季度会员</option>
                    <option value="yearly">年度会员</option>
                    <option value="permanent">永久会员</option>
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">初始积分</label>
                <input type="number" id="add-points" value="0" min="0" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-violet-500">
            </div>
            <div class="flex items-center gap-2">
                <input type="checkbox" id="add-admin" class="w-4 h-4 text-violet-600 rounded focus:ring-violet-500">
                <label for="add-admin" class="text-sm text-gray-700 cursor-pointer">设为管理员</label>
            </div>
            <div class="flex gap-3 pt-4">
                <button type="submit" class="flex-1 py-3 bg-gradient-to-r from-violet-500 to-purple-600 text-white font-medium rounded-xl hover:from-violet-600 hover:to-purple-700">创建</button>
                <button type="button" onclick="closeAddModal()" class="flex-1 py-3 border border-gray-200 text-gray-600 font-medium rounded-xl hover:bg-gray-50">取消</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
function editUser(id, membership, points, frozen, admin) {
    document.getElementById('edit-user-id').value = id;
    document.getElementById('edit-membership').value = membership;
    document.getElementById('edit-points').value = points;
    document.getElementById('edit-frozen').checked = frozen;
    document.getElementById('edit-admin').checked = admin;
    document.getElementById('edit-modal').classList.remove('hidden');
}

function closeEditModal() {
    document.getElementById('edit-modal').classList.add('hidden');
}

function showAddUserModal() {
    document.getElementById('add-modal').classList.remove('hidden');
}

function closeAddModal() {
    document.getElementById('add-modal').classList.add('hidden');
}

document.getElementById('edit-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const id = document.getElementById('edit-user-id').value;
    const data = {
        membership_type: document.getElementById('edit-membership').value,
        points: parseInt(document.getElementById('edit-points').value),
        is_frozen: document.getElementById('edit-frozen').checked,
        is_admin: document.getElementById('edit-admin').checked
    };

    try {
        const res = await fetch(`/xuadmin/users/${id}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        const result = await res.json();
        if (result.success) window.location.reload();
        else showError(result.message);
    } catch (err) {
        showError('更新失败');
    }
});

document.getElementById('add-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = {
        username: document.getElementById('add-username').value,
        email: document.getElementById('add-email').value,
        password: document.getElementById('add-password').value,
        membership_type: document.getElementById('add-membership').value,
        points: parseInt(document.getElementById('add-points').value) || 0,
        is_admin: document.getElementById('add-admin').checked
    };

    try {
        const res = await fetch('/xuadmin/users', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        const result = await res.json();
        if (result.success) window.location.reload();
        else showError(result.message);
    } catch (err) {
        showError('创建失败');
    }
});

async function deleteUser(id) {
    showConfirm('确定要删除这个用户吗？', async () => {
        try {
            const res = await fetch(`/xuadmin/users/${id}`, { method: 'DELETE' });
            const result = await res.json();
            if (result.success) window.location.reload();
            else showError(result.message);
        } catch (err) {
            showError('删除失败');
        }
    });
}
</script>
{% endblock %}
