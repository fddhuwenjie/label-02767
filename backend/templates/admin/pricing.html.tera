{% extends "admin/base" %}

{% block title %}定价管理 - 后台管理{% endblock %}
{% block page_title %}定价管理{% endblock %}

{% block content %}
<!-- 定价卡片 -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    {% for p in pricing %}
    <div class="bg-white rounded-2xl border border-gray-100 shadow-lg shadow-gray-100/50 overflow-hidden hover:shadow-xl transition-shadow
        {% if p.membership_type == 'permanent' %}ring-2 ring-violet-500{% endif %}">
        <!-- 顶部装饰 -->
        <div class="h-2 
            {% if p.membership_type == 'monthly' %}bg-blue-500
            {% elif p.membership_type == 'quarterly' %}bg-emerald-500
            {% elif p.membership_type == 'yearly' %}bg-amber-500
            {% else %}bg-gradient-to-r from-violet-500 to-purple-600{% endif %}">
        </div>
        
        <div class="p-6">
            <!-- 标题 -->
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-semibold text-gray-900">
                    {% if p.membership_type == "monthly" %}月度会员
                    {% elif p.membership_type == "quarterly" %}季度会员
                    {% elif p.membership_type == "yearly" %}年度会员
                    {% elif p.membership_type == "permanent" %}永久会员
                    {% endif %}
                </h3>
                {% if p.is_active %}
                <span class="px-2 py-1 bg-green-100 text-green-700 text-xs font-medium rounded-full">启用</span>
                {% else %}
                <span class="px-2 py-1 bg-gray-100 text-gray-500 text-xs font-medium rounded-full">禁用</span>
                {% endif %}
            </div>

            <!-- 价格 -->
            <div class="mb-4">
                <span class="text-4xl font-bold text-gray-900">¥{{ p.price }}</span>
                <span class="text-gray-500 text-sm">
                    {% if p.membership_type == "monthly" %}/月
                    {% elif p.membership_type == "quarterly" %}/季
                    {% elif p.membership_type == "yearly" %}/年
                    {% elif p.membership_type == "permanent" %}/永久
                    {% endif %}
                </span>
            </div>

            <!-- 描述 -->
            <p class="text-gray-500 text-sm mb-6">{{ p.description | default(value="暂无描述") }}</p>

            <!-- 编辑按钮 -->
            <button onclick="editPricing('{{ p.id }}', {{ p.price }}, '{{ p.description | default(value='') }}', {{ p.is_active }})" 
                    class="w-full py-2.5 border border-gray-200 text-gray-600 font-medium rounded-xl hover:bg-gray-50 hover:border-gray-300 transition-colors">
                编辑定价
            </button>
        </div>
    </div>
    {% endfor %}
</div>

<!-- 说明卡片 -->
<div class="mt-8 bg-violet-50 rounded-2xl p-6 border border-violet-100">
    <div class="flex items-start gap-4">
        <div class="w-10 h-10 bg-violet-100 rounded-xl flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-violet-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
        </div>
        <div>
            <h4 class="font-semibold text-gray-900 mb-1">定价说明</h4>
            <p class="text-gray-600 text-sm">
                会员定价会直接影响前台展示和用户购买。修改价格后，新订单将使用新价格，已有订单不受影响。
                禁用某个会员类型后，用户将无法购买该类型的会员。
            </p>
        </div>
    </div>
</div>

<!-- 编辑弹窗 -->
<div id="edit-modal" class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm flex items-center justify-center z-50 p-4">
    <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full">
        <div class="px-6 py-4 border-b border-gray-100">
            <h3 class="text-lg font-semibold text-gray-900">编辑定价</h3>
        </div>
        <form id="edit-form" class="p-6 space-y-5">
            <input type="hidden" id="edit-id">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">价格 (元)</label>
                <div class="relative">
                    <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-500">¥</span>
                    <input type="number" step="0.01" id="edit-price" required 
                           class="w-full pl-10 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-violet-500 focus:bg-white">
                </div>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">描述</label>
                <input type="text" id="edit-description" placeholder="如：30天会员权益"
                       class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-violet-500 focus:bg-white">
            </div>
            <div>
                <label class="flex items-center gap-3 cursor-pointer">
                    <div class="relative">
                        <input type="checkbox" id="edit-active" class="peer sr-only">
                        <div class="w-11 h-6 bg-gray-200 rounded-full peer-checked:bg-violet-600 transition-colors"></div>
                        <div class="absolute left-0.5 top-0.5 w-5 h-5 bg-white rounded-full shadow peer-checked:translate-x-5 transition-transform"></div>
                    </div>
                    <span class="text-sm text-gray-700">启用此定价</span>
                </label>
            </div>
            <div class="flex gap-3 pt-4">
                <button type="submit" class="flex-1 py-3 bg-gradient-to-r from-violet-500 to-purple-600 text-white font-medium rounded-xl hover:from-violet-600 hover:to-purple-700">保存</button>
                <button type="button" onclick="closeModal()" class="flex-1 py-3 border border-gray-200 text-gray-600 font-medium rounded-xl hover:bg-gray-50">取消</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
function editPricing(id, price, description, active) {
    document.getElementById('edit-id').value = id;
    document.getElementById('edit-price').value = price;
    document.getElementById('edit-description').value = description;
    document.getElementById('edit-active').checked = active;
    document.getElementById('edit-modal').classList.remove('hidden');
}

function closeModal() {
    document.getElementById('edit-modal').classList.add('hidden');
}

document.getElementById('edit-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const id = document.getElementById('edit-id').value;
    const data = {
        price: parseFloat(document.getElementById('edit-price').value),
        description: document.getElementById('edit-description').value || null,
        is_active: document.getElementById('edit-active').checked
    };

    try {
        const res = await fetch(`/xuadmin/pricing/${id}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        const result = await res.json();
        if (result.success) window.location.reload();
        else alert(result.message);
    } catch (err) {
        alert('更新失败');
    }
});
</script>
{% endblock %}
